SELECT l.name, l.list_type, count(lc.unicode) AS total
FROM app.user_lists l
LEFT JOIN app.list_characters lc ON lc.list_id = l.list_id
WHERE l.user_id = '01a1c73f-a157-7eed-8388-49b0a8b7b2b9' AND l.deleted_at IS NULL
GROUP BY l.name, l.list_type
ORDER BY l.list_type, l.name;
