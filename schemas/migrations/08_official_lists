  SELECT '01a1c73f-a157-7eed-8388-49b0a8b7b2b9', name, true, list_type
  FROM defs
  RETURNING list_id, name
)
INSERT INTO app.list_characters (list_id, unicode)
SELECT nl.list_id, c.unicode
FROM new_lists nl
JOIN defs d ON d.name = nl.name
CROSS JOIN LATERAL regexp_split_to_table(d.chars, '') WITH ORDINALITY AS t(ch, n)
JOIN (
  SELECT unicode, literal::text AS lit FROM japanese.kana
  UNION ALL
  SELECT unicode, literal::text FROM japanese.kanji
) c ON c.lit = t.ch
ORDER BY nl.list_id, t.n;

WITH defs(name, list_type) AS (VALUES
  ('Hiragana - Complete', 'hiragana'),
  ('Katakana - Complete', 'katakana')
),
new_lists AS (
  INSERT INTO app.user_lists (user_id, name, is_public, list_type)
  SELECT '01a1c73f-a157-7eed-8388-49b0a8b7b2b9', name, true, list_type
  FROM defs
  RETURNING list_id, name
)
INSERT INTO app.list_characters (list_id, unicode)
SELECT nl.list_id, k.unicode
FROM new_lists nl
JOIN defs d ON d.name = nl.name
JOIN japanese.kana k ON k.type = d.list_type
ORDER BY nl.list_id, k.literal COLLATE "C";

WITH new_lists AS (
  INSERT INTO app.user_lists (user_id, name, is_public, list_type)
  SELECT '01a1c73f-a157-7eed-8388-49b0a8b7b2b9', 'Kanji - JLPT Level ' || level, true, 'kanji'
  FROM japanese.jlpt
  RETURNING list_id, name
)
INSERT INTO app.list_characters (list_id, unicode)
SELECT nl.list_id, k.unicode
FROM new_lists nl
JOIN japanese.jlpt j ON nl.name = 'Kanji - JLPT Level ' || j.level
JOIN japanese.kanji k ON k.jlpt_level = j.level
ORDER BY nl.list_id, k.frequency_of_use NULLS LAST, k.unicode;

WITH new_lists AS (
  INSERT INTO app.user_lists (user_id, name, is_public, list_type)
  SELECT '01a1c73f-a157-7eed-8388-49b0a8b7b2b9', 'Kanji - School Grade ' || level, true, 'kanji'
  FROM japanese.grade
  RETURNING list_id, name
)
INSERT INTO app.list_characters (list_id, unicode)
SELECT nl.list_id, k.unicode
FROM new_lists nl
JOIN japanese.grade g ON nl.name = 'Kanji - School Grade ' || g.level
JOIN japanese.kanji k ON k.grade_level = g.level
ORDER BY nl.list_id, k.frequency_of_use NULLS LAST, k.unicode;


WITH defs(name, top_n) AS (VALUES
  ('Kanji - Top 100 Most Common', 100),
  ('Kanji - Top 500 Most Common', 500)
),
new_lists AS (
  INSERT INTO app.user_lists (user_id, name, is_public, list_type)
  SELECT '01a1c73f-a157-7eed-8388-49b0a8b7b2b9', name, true, 'kanji'
  FROM defs
  RETURNING list_id, name
),
ranked AS (
  SELECT unicode, row_number() OVER (ORDER BY frequency_of_use, unicode) AS rk
  FROM japanese.kanji
  WHERE frequency_of_use IS NOT NULL
)
INSERT INTO app.list_characters (list_id, unicode)
SELECT nl.list_id, r.unicode
FROM new_lists nl
JOIN defs d ON d.name = nl.name
JOIN ranked r ON r.rk <= d.top_n
ORDER BY nl.list_id, r.rk;


WITH defs(name, lo, hi) AS (VALUES
  ('Kanji - 1 to 4 Strokes',  1, 4),
  ('Kanji - 5 to 7 Strokes',  5, 7),
  ('Kanji - 8 to 10 Strokes', 8, 10)
),
new_lists AS (
  INSERT INTO app.user_lists (user_id, name, is_public, list_type)
  SELECT '01a1c73f-a157-7eed-8388-49b0a8b7b2b9', name, true, 'kanji'
  FROM defs
  RETURNING list_id, name
)
INSERT INTO app.list_characters (list_id, unicode)
SELECT nl.list_id, k.unicode
FROM new_lists nl
JOIN defs d ON d.name = nl.name
JOIN japanese.kanji k
  ON k.frequency_of_use IS NOT NULL
 AND k.stroke_count BETWEEN d.lo AND d.hi
ORDER BY nl.list_id, k.frequency_of_use, k.unicode;

